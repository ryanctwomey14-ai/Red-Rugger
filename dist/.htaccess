# Generated by build.js — do not edit by hand.
Options -MultiViews
RewriteEngine On

# Serve /about for /about.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Preserve the previous WordPress URLs
RedirectMatch 301 ^/about-us/?$ /about.html
RedirectMatch 301 ^/services/?$ /fix-flip-buy-hold.html
RedirectMatch 301 ^/fix-flip-buy-hold/?$ /fix-flip-buy-hold.html
RedirectMatch 301 ^/private-money-lender/?$ /lending.html
RedirectMatch 301 ^/investors/?$ /invest.html
RedirectMatch 301 ^/contact-us/?$ /contact.html
RedirectMatch 301 ^/faq/?$ /faq.html
RedirectMatch 301 ^/terms-and-conditions/?$ /terms.html
RedirectMatch 301 ^/privacy-policy/?$ /privacy.html
RedirectMatch 301 ^/sell-your-house/?$ /sell.html
RedirectMatch 301 ^/sell-your-property/?$ /sell.html
RedirectMatch 301 ^/multifamily/?$ /multifamily.html
RedirectMatch 301 ^/invest/?$ /invest.html
RedirectMatch 301 ^/disclosures/?$ /disclosures.html

# Long cache for fingerprinted assets, short for HTML
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>
